class GPUData:
    def __init__(self, T, info, device):
        keys = ["day", "evw", "obj_tok", "obj_cnt", "course", "sib", "userf", "static", "y",
                "cf", "pop", "vocab", "obj_type", "obj_rel", "sib_didx", "sib_vis"]
        self.t = {k: torch.as_tensor(T[k]).to(device) for k in keys}
        self.t["obj_tok"] = self.t["obj_tok"].long()
        self.t["sib_didx"] = self.t["sib_didx"].long()
        self.S, self.dev = info["S"], device

    def batch(self, idx, args, train=False, occl=()):
        t, S = self.t, self.S
        sib = t["sib"][idx]; sv = sib >= 0; sc = sib.clamp(min=0)
        if args.no_siblings:
            sv = torch.zeros_like(sv)
        c = t["course"][idx]
        o = t["obj_tok"][idx]; ov = o >= 0; oc = o.clamp(min=0)
        if args.no_objects:
            ov = torch.zeros_like(ov)
        voc = t["vocab"][oc] * ov
        if train and args.obj_drop > 0:
            voc = voc * (torch.rand(voc.shape, device=self.dev) > args.obj_drop)
        sidx = torch.arange(S, device=self.dev)[None, :, None].expand_as(oc)
        evw = t["evw"][idx]
        return dict(
            day=t["day"][idx], sib_day=t["day"][sc] * sv[..., None, None], sib_valid=sv,
            sib_didx=t["sib_didx"][idx], sib_vis=t["sib_vis"][idx] & sv[..., None],
            sib_course=t["course"][sc], userf=t["userf"][idx], course=c, cf=t["cf"][c],
            evw=evw, evw_raw=evw[..., 0],
            obj_valid=ov, obj_vocab=voc, obj_type=t["obj_type"][oc], obj_rel=t["obj_rel"][oc] * ov,
            obj_pop=t["pop"][oc, sidx] * ov, obj_cnt=t["obj_cnt"][idx] * ov,
            static=t["static"][idx], y=t["y"][idx], occl=occl)


def run_epoch(model, data, idx_all, args, opt=None, sched=None, scaler=None, ema=None, keep_attn=False, occl=()):
    train = opt is not None
    model.train(train)
    dev = data.dev
    if train:
        idx_all = idx_all[torch.randperm(len(idx_all), device=dev)]
    P, E, Z, loss_sum = [], [], [], 0.0
    type_att = evt_att = None
    amp = dev.type == "cuda"
    for i in range(0, len(idx_all), args.batch):
        idx = idx_all[i:i + args.batch]
        if train and len(idx) < 2:
            continue
        b = data.batch(idx, args, train, occl)
        with torch.set_grad_enabled(train), torch.autocast(dev.type, dtype=torch.float16, enabled=amp):
            logit, early, z = model(b, keep_attn=keep_attn)
            loss = F.binary_cross_entropy_with_logits(logit.float(), b["y"])
            aux = F.binary_cross_entropy_with_logits(early.float(), b["y"][:, None].expand_as(early))
            tot = loss + args.aux_w * aux
        if train:
            opt.zero_grad(set_to_none=True)
            scaler.scale(tot).backward()
            scaler.unscale_(opt)
            nn.utils.clip_grad_norm_(model.parameters(), 1.0)
            scaler.step(opt); scaler.update(); sched.step()
            if ema is not None:
                ema.update_parameters(model)
        else:
            P.append(torch.sigmoid(logit.float()).cpu()); E.append(torch.sigmoid(early.float()).cpu())
            if keep_attn:
                Z.append(z.float().cpu())
                row = model.graph[-1].last_attn[:, :, 0].mean(1).view(len(idx), model.S, -1)
                pt = torch.zeros(len(idx), model.S, N_TYPES, device=dev)
                pt.index_add_(2, model.types, row)
                ea = row[:, :, model.e0:model.o0]
                type_att = pt.sum(0) if type_att is None else type_att + pt.sum(0)
                evt_att = ea.sum(0) if evt_att is None else evt_att + ea.sum(0)
        loss_sum += loss.item() * len(idx)
    out = dict(loss=loss_sum / max(len(idx_all), 1))
    if not train:
        out.update(p=torch.cat(P).numpy(), early=torch.cat(E).numpy())
        if keep_attn:
            out["z"] = torch.cat(Z).numpy().astype(np.float16)
            out["type_att"] = (type_att / type_att.sum(-1, keepdim=True)).cpu().numpy()
            out["evt_att"] = (evt_att / evt_att.sum(-1, keepdim=True)).cpu().numpy()
    return out


def param_groups(model, wd):
    decay, no_decay = [], []
    for n, p in model.named_parameters():
        if not p.requires_grad:
            continue
        if p.ndim < 2 or any(k in n for k in ["emb", "pos", ".mu", ".rb", ".ew", "norm"]):
            no_decay.append(p)
        else:
            decay.append(p)
    return [dict(params=decay, weight_decay=wd), dict(params=no_decay, weight_decay=0.0)]


def train_run(exp_key, seed, info, data, idx, yv, base_args, run_dir, keep_attn=False):
    path = os.path.join(run_dir, f"{exp_key}_s{seed}.npz")
    if os.path.exists(path):
        print(f"  [skip] {path} exists")
        z = np.load(path, allow_pickle=True)
        return {k: z[k] for k in z.files}
    from torch.optim.swa_utils import AveragedModel, get_ema_multi_avg_fn
    args = copy.copy(base_args)
    for k, v in EXPERIMENTS[exp_key]["flags"].items():
        setattr(args, k, v)
    seed_all(seed)
    dev = data.dev
    model = THGTv2(info, args).to(dev)
    ema = AveragedModel(model, multi_avg_fn=get_ema_multi_avg_fn(args.ema), use_buffers=True)
    opt = torch.optim.AdamW(param_groups(model, args.wd), lr=args.lr)
    spe = math.ceil(len(idx["train"]) / args.batch)
    total, warm = args.epochs * spe, max(1, int(args.warmup * args.epochs * spe))

    def lr_lambda(step):
        if step < warm:
            return (step + 1) / warm
        prog = min(1.0, (step - warm) / max(1, total - warm))
        return 0.02 + 0.98 * 0.5 * (1 + math.cos(math.pi * prog))
    sched = torch.optim.lr_scheduler.LambdaLR(opt, lr_lambda)
    scaler = torch.amp.GradScaler("cuda", enabled=dev.type == "cuda")
    n_par = sum(p.numel() for p in model.parameters())
    print(f"\n=== {EXPERIMENTS[exp_key]['name']} | seed {seed} | params {n_par/1e6:.2f}M ===")

    best, bad, hist, best_state, ep_times = -1.0, 0, [], None, []
    for ep in range(1, args.epochs + 1):
        t1 = time.time()
        tr = run_epoch(model, data, idx["train"], args, opt, sched, scaler, ema)
        va = run_epoch(ema.module, data, idx["val"], args)
        auc = float(roc_auc_score(yv, va["p"])); auc_e = float(roc_auc_score(yv, va["early"][:, -1]))
        ep_times.append(time.time() - t1)
        hist.append(dict(epoch=ep, train_loss=tr["loss"], val_loss=va["loss"], val_auc=auc, val_auc_graph=auc_e))
        star = ""
        if auc > best:
            best, bad, star = auc, 0, " *"
            best_state = {k: v.detach().cpu().clone() for k, v in ema.module.state_dict().items()}
        else:
            bad += 1
        print(f"  ep {ep:02d} | tr {tr['loss']:.4f} | va {va['loss']:.4f} | AUC {auc:.4f} | "
              f"graph-head AUC {auc_e:.4f} | {time.time()-t1:.0f}s{star}")
        if bad >= args.patience:
            print("  [early stop]"); break

    ema.module.load_state_dict(best_state)
    m = ema.module
    va = run_epoch(m, data, idx["val"], args)
    t2 = time.time()
    te = run_epoch(m, data, idx["test"], args, keep_attn=keep_attn and not args.no_graph)
    infer = time.time() - t2
    res = dict(val_p=va["p"], val_early=va["early"], test_p=te["p"], test_early=te["early"],
               history=np.array(json.dumps(hist)), n_params=np.array(n_par),
               epoch_sec=np.array(np.mean(ep_times)), infer_ms_per_1k=np.array(1000 * infer / len(idx["test"]) * 1000),
               best_epoch=np.array(int(np.argmax([h["val_auc"] for h in hist])) + 1))
    for k in ["z", "type_att", "evt_att"]:
        if k in te:
            res[k] = te[k]
    np.savez(path, **res)
    if exp_key in KEEP_STATE:
        torch.save(best_state, os.path.join(run_dir, f"{exp_key}_s{seed}_model.pt"))
    del model, ema, opt, m
    gc.collect()
    if dev.type == "cuda":
        torch.cuda.empty_cache()
    return {k: (v if not isinstance(v, np.ndarray) else v) for k, v in res.items()}



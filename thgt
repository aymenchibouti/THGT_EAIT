class TypedLinear(nn.Module):
    def __init__(self, n_types, d_in, d_out):
        super().__init__()
        self.W = nn.Parameter(torch.empty(n_types, d_out, d_in))
        self.b = nn.Parameter(torch.zeros(n_types, d_out))
        for i in range(n_types):
            nn.init.xavier_uniform_(self.W[i])

    def forward(self, x, types):
        return torch.einsum("bld,lod->blo", x, self.W[types]) + self.b[types]


class HGTLayer(nn.Module):
    def __init__(self, d, heads, dropout):
        super().__init__()
        self.h, self.dk = heads, d // heads
        self.q = TypedLinear(N_TYPES, d, d)
        self.k = TypedLinear(N_TYPES, d, d)
        self.v = TypedLinear(N_TYPES, d, d)
        self.o = TypedLinear(N_TYPES, d, d)
        self.mu = nn.Parameter(torch.ones(heads, N_TYPES, N_TYPES))
        self.rb = nn.Parameter(torch.zeros(heads, N_TYPES, N_TYPES))
        self.ew = nn.Parameter(torch.full((heads,), 0.1))             # edge-weight bias scale
        self.n1, self.n2 = nn.LayerNorm(d), nn.LayerNorm(d)
        self.ff = nn.Sequential(nn.Linear(d, 2 * d), nn.GELU(), nn.Dropout(dropout), nn.Linear(2 * d, d))
        self.drop = nn.Dropout(dropout)
        self.last_attn = None

    def forward(self, x, types, adj, ew, keep_attn=False):
        B, L, _ = x.shape
        hx = self.n1(x)
        q = self.q(hx, types).view(B, L, self.h, self.dk).transpose(1, 2).float()
        k = self.k(hx, types).view(B, L, self.h, self.dk).transpose(1, 2).float()
        v = self.v(hx, types).view(B, L, self.h, self.dk).transpose(1, 2)
        att = (q @ k.transpose(-1, -2)) / math.sqrt(self.dk)
        att = att * self.mu[:, types][:, :, types].float() + self.rb[:, types][:, :, types].float()
        att = att + self.ew.float()[None, :, None, None] * ew[:, None]
        att = torch.softmax(att.masked_fill(~adj[:, None], -1e9), -1)
        if keep_attn:
            self.last_attn = att.detach()
        out = (self.drop(att).to(v.dtype) @ v).transpose(1, 2).reshape(B, L, -1)
        x = x + self.drop(self.o(out, types))
        return x + self.drop(self.ff(self.n2(x)))


def causal_mask(L, dev):
    return torch.triu(torch.ones(L, L, dtype=torch.bool, device=dev), 1)


def tf_encoder(d, heads, layers, dropout):
    el = nn.TransformerEncoderLayer(d, heads, 2 * d, dropout, batch_first=True, norm_first=True, activation="gelu")
    return nn.TransformerEncoder(el, layers, enable_nested_tensor=False)


class THGTv2(nn.Module):
    def __init__(self, info, args):
        super().__init__()
        d, S, M, K = args.d, info["S"], info["M"], info["K"]
        self.args, self.S, self.M, self.K = args, S, M, K
        self.register_buffer("snap_idx", torch.tensor([x - 1 for x in info["snap_days"]]), persistent=False)
        self.register_buffer("snap_day", torch.tensor(info["snap_days"], dtype=torch.float32), persistent=False)

        self.day_in = nn.Sequential(nn.Linear(info["n_day_feat"], d), nn.GELU(), nn.Linear(d, d))
        self.day_pos = nn.Parameter(torch.randn(1, NDAYS, d) * 0.02)
        self.day_enc = tf_encoder(d, args.heads, args.day_layers, args.dropout)
        self.day_norm = nn.LayerNorm(d)

        self.type_emb = nn.Embedding(N_TYPES, d)
        self.snap_emb = nn.Embedding(S, d)
        self.user_in = nn.Linear(2, d)
        self.course_emb = nn.Embedding(info["n_course"], d)
        self.course_in = nn.Linear(5, d)
        self.evt_emb = nn.Embedding(7, d)
        self.evt_in = nn.Sequential(nn.Linear(3, d), nn.LayerNorm(d))
        self.obj_emb = nn.Embedding(info["n_vocab"], d)
        self.obj_in = nn.Sequential(nn.Linear(4, d), nn.LayerNorm(d))

        self.graph = nn.ModuleList([HGTLayer(d, args.heads, args.dropout) for _ in range(args.graph_layers)])
        self.g_norm = nn.LayerNorm(d)

        self.e0, self.o0 = 3, 10
        self.s0 = self.o0 + M
        L = self.s0 + K
        self.L = L
        types = [T_ENR, T_USER, T_COURSE] + [T_EVT] * 7 + [T_OBJ] * M + [T_SIB] * K
        self.register_buffer("types", torch.tensor(types), persistent=False)
        ltypes = torch.zeros(L, dtype=torch.long) if getattr(args, "no_hetero", False) else torch.tensor(types)
        self.register_buffer("ltypes", ltypes, persistent=False)   # types seen by HGT parameters
        A = torch.zeros(L, L, dtype=torch.bool)
        e0, o0, s0 = self.e0, self.o0, self.s0
        A[0, :] = A[:, 0] = True
        A[1, s0:] = A[s0:, 1] = True
        A[2, e0:s0] = A[e0:s0, 2] = True            # course ↔ event types & objects
        A |= torch.eye(L, dtype=torch.bool)
        if args.no_graph:
            A = torch.eye(L, dtype=torch.bool)
        self.register_buffer("A", A, persistent=False)

        self.snap_pos = nn.Parameter(torch.randn(1, S, d) * 0.02)
        self.snap_enc = tf_encoder(d, args.heads, args.snap_layers, args.dropout)
        self.snap_norm = nn.LayerNorm(d)
        self.early_head = nn.Linear(d, 1)

        self.use_static = not args.no_static
        if self.use_static:
            self.static = nn.Sequential(nn.Linear(info["n_static"], 2 * d), nn.BatchNorm1d(2 * d), nn.GELU(),
                                        nn.Dropout(args.dropout), nn.Linear(2 * d, d), nn.GELU())
        self.head = nn.Sequential(nn.Linear(d * (3 if self.use_static else 2), d), nn.GELU(),
                                  nn.Dropout(args.dropout), nn.Linear(d, 1))

    def forward(self, b, keep_attn=False):
        B, K, S, M = b["day"].shape[0], self.K, self.S, self.M
        d = self.day_pos.shape[-1]
        dev = b["day"].device
        te = self.type_emb.weight

        # 1) day-level temporal encoder (target + siblings)
        x = torch.cat([b["day"][:, None], b["sib_day"]], 1).reshape(B * (1 + K), NDAYS, -1)
        H = self.day_norm(self.day_enc(self.day_in(x) + self.day_pos, mask=causal_mask(NDAYS, dev)))
        H = H.view(B, 1 + K, NDAYS, d)
        Hs = torch.gather(H[:, 1:], 2, b["sib_didx"][..., None].expand(-1, -1, -1, d))   # (B,K,S,d) calendar-aligned
        H = torch.cat([H[:, :1, self.snap_idx], Hs], 1)                            # (B,1+K,S,d)

        # 2) snapshot tokens
        enr = (H[:, 0] + te[T_ENR])[:, :, None]
        usr = (self.user_in(b["userf"]) + te[T_USER])[:, None, None].expand(B, S, 1, d)
        crs = (self.course_emb(b["course"])[:, None] + self.course_in(b["cf"]) + te[T_COURSE])[:, :, None]
        evt = self.evt_emb.weight[None, None] + self.evt_in(b["evw"]) + te[T_EVT]            # (B,S,7,d)
        age = (self.snap_day[None, :, None] - b["obj_rel"]) / NDAYS
        of = torch.stack([b["obj_cnt"], b["obj_pop"], b["obj_rel"] / NDAYS, age], -1)
        obj = (self.obj_emb(b["obj_vocab"]) + self.obj_in(of) + self.evt_emb(b["obj_type"])
               + self.course_emb(b["course"])[:, None, None] + te[T_OBJ])                    # (B,S,M,d)
        sib = H[:, 1:].transpose(1, 2) + self.course_emb(b["sib_course"])[:, None] + te[T_SIB]
        tok = torch.cat([enr, usr, crs, evt, obj, sib], 2) + self.snap_emb.weight[None, :, None]
        L = tok.shape[2]
        x = tok.reshape(B * S, L, d)

        # adjacency (dynamic parts: object validity & object→event-type links)
        e0, o0, s0 = self.e0, self.o0, self.s0
        valid = torch.ones(B, S, L, dtype=torch.bool, device=dev)
        valid[:, :, o0:s0] = b["obj_valid"]
        valid[:, :, s0:] = b["sib_vis"].transpose(1, 2)
        for nm in b.get("occl", ()):                         # inference-time node-type occlusion
            if nm == "user": valid[:, :, 1] = False
            elif nm == "course": valid[:, :, 2] = False
            elif nm == "event_type": valid[:, :, e0:o0] = False
            elif nm == "object": valid[:, :, o0:s0] = False
            elif nm == "sibling": valid[:, :, s0:] = False
            elif nm.startswith("evt:"): valid[:, :, e0 + int(nm[4:])] = False
        adj = self.A[None, None].expand(B, S, L, L).clone()
        if not self.args.no_graph:
            oh = F.one_hot(b["obj_type"], 7).bool() & b["obj_valid"][..., None]          # (B,S,M,7)
            adj[:, :, o0:s0, e0:o0] = oh
            adj[:, :, e0:o0, o0:s0] = oh.transpose(-1, -2)
        adj = adj & valid[:, :, None, :]
        adj = (adj | torch.eye(L, dtype=torch.bool, device=dev)).reshape(B * S, L, L)

        ew = torch.zeros(B, S, L, L, device=dev)
        ew[:, :, 0, e0:o0] = b["evw_raw"]; ew[:, :, e0:o0, 0] = b["evw_raw"]
        ew[:, :, 0, o0:s0] = b["obj_cnt"]; ew[:, :, o0:s0, 0] = b["obj_cnt"]
        ew = ew.reshape(B * S, L, L)

        for layer in self.graph:
            x = layer(x, self.ltypes, adj, ew, keep_attn)
        z = self.g_norm(x[:, 0]).view(B, S, d)

        # 3) snapshot temporal encoder (causal)
        zt = self.snap_norm(self.snap_enc(z + self.snap_pos, mask=causal_mask(S, dev)))
        early = self.early_head(zt).squeeze(-1)
        feats = [zt[:, -1], zt.mean(1)]
        if self.use_static:
            feats.append(self.static(b["static"]))
        return self.head(torch.cat(feats, -1)).squeeze(-1), early, z





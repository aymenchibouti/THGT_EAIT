def ece_score(y, p, bins=15):
    edges = np.linspace(0, 1, bins + 1); e = 0.0
    for lo, hi in zip(edges[:-1], edges[1:]):
        m = (p > lo) & (p <= hi)
        if m.any():
            e += m.mean() * abs(y[m].mean() - p[m].mean())
    return float(e)


def best_threshold(y, p):
    g = np.linspace(0.05, 0.95, 91)
    return float(g[int(np.argmax([f1_score(y, (p >= t).astype(int), average="macro") for t in g]))])


def metrics(y, p, thr=0.5):
    p = np.clip(np.asarray(p, np.float64), 1e-7, 1 - 1e-7)
    yh = (p >= thr).astype(int)
    return dict(auc=float(roc_auc_score(y, p)), pr_auc=float(average_precision_score(y, p)),
                logloss=float(log_loss(y, p)), brier=float(brier_score_loss(y, p)), ece=ece_score(y, p),
                acc=float(accuracy_score(y, yh)), f1=float(f1_score(y, yh)),
                macro_f1=float(f1_score(y, yh, average="macro")),
                precision=float(precision_score(y, yh)), recall=float(recall_score(y, yh)), threshold=float(thr))


def bootstrap_ci(y, p, n=1000, seed=0):
    rng = np.random.RandomState(seed); N = len(y); a = []
    for _ in range(n):
        i = rng.randint(0, N, N)
        if y[i].min() != y[i].max():
            a.append(roc_auc_score(y[i], p[i]))
    return float(np.percentile(a, 2.5)), float(np.percentile(a, 97.5))


def delong_test(y, p1, p2):
    """DeLong et al. (1988) test for two correlated ROC AUCs (Sun & Xu 2014 formulation)."""
    y = np.asarray(y).astype(bool); m, n = y.sum(), (~y).sum()
    V10, V01, aucs = [], [], []
    for p in (p1, p2):
        px, py = p[y], p[~y]
        tx, ty, tz = rankdata(px), rankdata(py), rankdata(np.r_[px, py])
        aucs.append((tz[:m].sum() - m * (m + 1) / 2) / (m * n))
        V10.append((tz[:m] - tx) / n)
        V01.append(1.0 - (tz[m:] - ty) / m)
    S = np.cov(np.array(V10)) / m + np.cov(np.array(V01)) / n
    var = S[0, 0] + S[1, 1] - 2 * S[0, 1]
    z = (aucs[0] - aucs[1]) / np.sqrt(max(var, 1e-18))
    return float(aucs[0]), float(aucs[1]), float(z), float(2 * norm.sf(abs(z)))


def logit(p):
    p = np.clip(p, 1e-6, 1 - 1e-6); return np.log(p / (1 - p))


def blend(pa, pb, w):
    return 1 / (1 + np.exp(-(w * logit(pa) + (1 - w) * logit(pb))))


def tune_blend(yv, va, vb):
    ws = np.linspace(0, 1, 21)
    sc = [roc_auc_score(yv, blend(va, vb, w)) for w in ws]
    return float(ws[int(np.argmax(sc))])


def fmt(mu, sd=None, d=4):
    return f"{mu:.{d}f}" if sd is None or np.isnan(sd) else f"{mu:.{d}f} ± {sd:.{d}f}"


def df_to_md(df):
    cols = [str(c) for c in df.columns]
    lines = ["| " + " | ".join([df.index.name or ""] + cols) + " |",
             "|" + "---|" * (len(cols) + 1)]
    for i, r in df.iterrows():
        lines.append("| " + " | ".join([str(i)] + [str(v) for v in r.values]) + " |")
    return "\n".join(lines)



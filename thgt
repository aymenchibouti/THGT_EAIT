def lgb_fit_predict(Xtr, ytr, Xva, yva, Xte, seed, threads, cat=None):
    import lightgbm as lgb
    m = lgb.LGBMClassifier(n_estimators=4000, learning_rate=0.03, num_leaves=63, min_child_samples=40,
                           subsample=0.8, subsample_freq=1, colsample_bytree=0.5, reg_lambda=1.0,
                           random_state=seed, n_jobs=threads or -1, verbose=-1)
    m.fit(Xtr, ytr, eval_set=[(Xva, yva)], eval_metric="auc",
          callbacks=[lgb.early_stopping(150, verbose=False)],
          categorical_feature=cat if cat is not None else "auto")
    return m.predict_proba(Xva)[:, 1], m.predict_proba(Xte)[:, 1], m.best_iteration_


def run_lgb_full(T, sp, seed, args, run_dir):
    path = os.path.join(run_dir, f"lgb_full_s{seed}.npz")
    if os.path.exists(path):
        z = np.load(path); return dict(val_p=z["val_p"], test_p=z["test_p"])
    X = pd.DataFrame(T["static"]); X.columns = [f"f{i}" for i in range(X.shape[1])]
    X["course"] = pd.Categorical(T["course"])
    y = T["y"]
    t1 = time.time()
    vp, tp, it = lgb_fit_predict(X[sp == 0], y[sp == 0], X[sp == 1], y[sp == 1], X[sp == 2], seed,
                                 args.lgb_threads, cat=["course"])
    print(f"  LightGBM seed {seed}: val AUC {roc_auc_score(y[sp==1], vp):.4f} | iters {it} | {time.time()-t1:.0f}s")
    np.savez(path, val_p=vp, test_p=tp)
    return dict(val_p=vp, test_p=tp)


def causal_features(T, s, snap_every):
    D = (s + 1) * snap_every
    day = T["day"][:, :D]
    parts = [day.reshape(len(day), -1), day.mean(1), day[:, max(0, D - 5):D].mean(1),
             day[:, max(0, D - 5):D].max(1), T["evw"][:, :s + 1].reshape(len(day), -1), T["userf"]]
    X = pd.DataFrame(np.concatenate(parts, 1).astype(np.float32))
    X.columns = [f"f{i}" for i in range(X.shape[1])]
    X["course"] = pd.Categorical(T["course"])
    return X


def run_causal_lgb(T, info, sp, args, run_dir):
    path = os.path.join(run_dir, "lgb_causal.npz")
    if os.path.exists(path):
        z = np.load(path); return dict(val_early=z["val_early"], test_early=z["test_early"])
    y = T["y"]; S = info["S"]
    VE = np.zeros(((sp == 1).sum(), S)); TE = np.zeros(((sp == 2).sum(), S))
    for s in range(S):
        t1 = time.time()
        X = causal_features(T, s, info["snap_every"])
        vp, tp, it = lgb_fit_predict(X[sp == 0], y[sp == 0], X[sp == 1], y[sp == 1], X[sp == 2], 0,
                                     args.lgb_threads, cat=["course"])
        VE[:, s], TE[:, s] = vp, tp
        print(f"  Causal-LightGBM day {info['snap_days'][s]:2d}: val AUC {roc_auc_score(y[sp==1], vp):.4f} "
              f"| feats {X.shape[1]} | {time.time()-t1:.0f}s")
        del X; gc.collect()
    np.savez(path, val_early=VE, test_early=TE)
    return dict(val_early=VE, test_early=TE)



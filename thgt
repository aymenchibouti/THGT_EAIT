# 1. Raw logs → temporal heterogeneous graph tensors
# ==================================================================================
def read_logs(path, keep_eids=None, chunksize=2_000_000):
    ev_map = {a: i for i, a in enumerate(ACTS)}
    parts, objs = [], []
    t0 = time.time()
    reader = pd.read_csv(path, chunksize=chunksize, usecols=["enrollment_id", "time", "source", "event", "object"],
                         dtype={"enrollment_id": np.int32, "time": str, "source": str, "event": str, "object": str})
    for ch in reader:
        if keep_eids is not None:
            ch = ch[ch["enrollment_id"].isin(keep_eids)]
        if len(ch) == 0:
            continue
        ts = pd.to_datetime(ch["time"], format="%Y-%m-%dT%H:%M:%S", errors="coerce")
        ok = ts.notna().values & ch["event"].isin(ev_map).values
        ch, ts = ch[ok], ts[ok]
        parts.append(dict(
            eid=ch["enrollment_id"].values.astype(np.int32),
            t=(ts.values.astype("datetime64[s]").astype(np.int64)),
            src=(ch["source"].values == "browser").astype(np.int8),
            ev=ch["event"].map(ev_map).values.astype(np.int8)))
        objs.append(pd.Categorical(ch["object"].fillna("NA").values))
        print(f"   read {sum(len(p['eid']) for p in parts):,} events  ({time.time()-t0:.0f}s)")
    obj = union_categoricals(objs)
    L = {k: np.concatenate([p[k] for p in parts]) for k in parts[0]}
    L["obj"] = obj.codes.astype(np.int32)
    L["n_obj"] = len(obj.categories)
    return L


def build_graph(logs, meta_df, args):
    S_E = args.snap_every
    S = NDAYS // S_E
    M, K = args.max_obj, args.max_sib
    N = len(meta_df)
    O = logs["n_obj"]

    eid2row = np.full(int(max(meta_df.enrollment_id.max(), logs["eid"].max())) + 1, -1, np.int64)
    eid2row[meta_df.enrollment_id.values] = np.arange(N)
    row = eid2row[logs["eid"]]
    keep = row >= 0
    row = row[keep]; t = logs["t"][keep]; src = logs["src"][keep]; ev = logs["ev"][keep].astype(np.int64)
    obj = logs["obj"][keep].astype(np.int64)
    del logs

    course_row = meta_df["course"].values.astype(np.int64)
    C = int(course_row.max()) + 1
    is_train = (meta_df["_split"].values == "train")
    crs = course_row[row]

    # ---- course-relative day ----
    dayabs = t // 86400
    cstart = np.full(C, np.iinfo(np.int64).max); np.minimum.at(cstart, crs, dayabs)
    d = np.clip(dayabs - cstart[crs], 0, NDAYS - 1)
    hour = (t % 86400) // 3600
    w = d // S_E
    snap_days = [(s + 1) * S_E for s in range(S)]

    # ---- sessions (30-min gap) ----
    order = np.lexsort((t, row))
    r_s, t_s, d_s = row[order], t[order], d[order]
    gap = np.diff(t_s, prepend=t_s[0])
    new = np.ones(len(r_s), bool); new[1:] = (r_s[1:] != r_s[:-1]) | (gap[1:] > 1800)
    dur = np.where(new, 0, gap).astype(np.float64)
    key_s = r_s * NDAYS + d_s
    sessions = np.bincount(key_s[new], minlength=N * NDAYS).reshape(N, NDAYS)
    duration = np.bincount(key_s, weights=dur, minlength=N * NDAYS).reshape(N, NDAYS) / 60.0
    del order, r_s, t_s, d_s, gap, new, dur, key_s

    # ---- object metadata ----
    obj_course = np.zeros(O, np.int64); obj_course[obj] = crs
    obj_type = np.bincount(obj * 7 + ev, minlength=O * 7).reshape(O, 7).argmax(1)
    obj_rel = np.full(O, NDAYS - 1, np.int64); np.minimum.at(obj_rel, obj, d)
    seen = np.zeros(O, bool); seen[obj] = True

    # ---- daily features (N,30,F) ----
    key = row * NDAYS + d
    evc = np.bincount(key * 7 + ev, minlength=N * NDAYS * 7).reshape(N, NDAYS, 7)
    tot = evc.sum(-1)
    bro = np.bincount(key[src == 1], minlength=N * NDAYS).reshape(N, NDAYS)
    uk = np.unique(key * O + obj)
    uobj = np.bincount(uk // O, minlength=N * NDAYS).reshape(N, NDAYS); del uk
    hk = np.unique(key * 24 + hour)
    ahours = np.bincount(hk // 24, minlength=N * NDAYS).reshape(N, NDAYS); del hk
    rel_cd = np.bincount(obj_course[seen] * NDAYS + obj_rel[seen], minlength=C * NDAYS).reshape(C, NDAYS)
    dow = (cstart[course_row][:, None] + np.arange(NDAYS)[None] + 3) % 7        # 0 = Monday
    day = np.concatenate([
        log1p(evc), log1p(tot)[..., None], log1p(uobj)[..., None],
        (bro / np.maximum(tot, 1)).astype(np.float32)[..., None],
        (ahours / 24.0).astype(np.float32)[..., None],
        log1p(sessions)[..., None], log1p(duration)[..., None],
        (tot > 0).astype(np.float32)[..., None],
        log1p(rel_cd[course_row])[..., None],
        np.sin(2 * np.pi * dow / 7).astype(np.float32)[..., None],
        np.cos(2 * np.pi * dow / 7).astype(np.float32)[..., None]], -1).astype(np.float32)
    mu = day[is_train].reshape(-1, day.shape[-1]).mean(0)
    sd = day[is_train].reshape(-1, day.shape[-1]).std(0) + 1e-6
    day = (day - mu) / sd
    active = tot > 0
    del bro, uobj, ahours, sessions, duration

    # ---- window (snapshot) event-type features (N,S,7,3) ----
    evw_cnt = evc.reshape(N, S, S_E, 7).sum(2)
    bro_ev = np.bincount((row * S + w) * 7 + ev, weights=src.astype(np.float64),
                         minlength=N * S * 7).reshape(N, S, 7)
    # unique objects per window & object ranking
    rw = row * S + w
    k2, cnt2 = np.unique(rw * O + obj, return_counts=True)
    rw2, o2 = k2 // O, k2 % O
    del k2
    uobj_ev = np.bincount(rw2 * 7 + obj_type[o2], minlength=N * S * 7).reshape(N, S, 7)
    evw = np.stack([log1p(evw_cnt), log1p(uobj_ev),
                    (bro_ev / np.maximum(evw_cnt, 1)).astype(np.float32)], -1).astype(np.float32)
    del bro_ev, uobj_ev, evc

    # top-M objects per (row, window)
    ordr = np.lexsort((-cnt2, rw2))
    rw2, o2, cnt2 = rw2[ordr], o2[ordr], cnt2[ordr]
    first = np.r_[0, np.flatnonzero(np.diff(rw2)) + 1]
    rank = np.arange(len(rw2)) - np.repeat(first, np.diff(np.r_[first, len(rw2)]))
    sel = rank < M
    obj_tok = -np.ones((N * S, M), np.int32)
    obj_cnt = np.zeros((N * S, M), np.float32)
    obj_tok[rw2[sel], rank[sel]] = o2[sel]
    obj_cnt[rw2[sel], rank[sel]] = np.log1p(cnt2[sel])
    obj_tok = obj_tok.reshape(N, S, M); obj_cnt = obj_cnt.reshape(N, S, M)

    # object vocab & causal popularity (train enrollments only, no labels)
    tr_mask = is_train[rw2 // S]
    pr = np.unique((rw2[tr_mask] // S) * O + o2[tr_mask])          # train (row,obj) pairs
    n_tr_enr_obj = np.bincount(pr % O, minlength=O)
    vocab = np.zeros(O, np.int64)
    good = n_tr_enr_obj >= args.min_obj_enr
    vocab[good] = np.arange(1, good.sum() + 1)
    # first window each train (row,obj) is seen → cumulative popularity
    tr_rw, tr_o = rw2[tr_mask], o2[tr_mask]
    fk = (tr_rw // S) * O + tr_o
    o3 = np.lexsort((tr_rw % S, fk))
    fk_s, win_s = fk[o3], (tr_rw % S)[o3]
    fsel = np.r_[True, fk_s[1:] != fk_s[:-1]]
    pop = np.bincount((fk_s[fsel] % O) * S + win_s[fsel], minlength=O * S).reshape(O, S).cumsum(1)
    ctrain = np.bincount(course_row[is_train], minlength=C).astype(np.float64)
    pop = (pop / np.maximum(ctrain[obj_course], 1)[:, None]).astype(np.float32)
    del rw2, o2, cnt2, rank, sel, pr, tr_rw, tr_o, fk, o3, fk_s, win_s, fsel, rw

    # ---- course snapshot features (C,S,5) ----
    act_w = active.reshape(N, S, S_E).any(2)
    cnt_w = np.log1p(tot.reshape(N, S, S_E).sum(2))
    cf = np.zeros((C, S, 5), np.float32)
    rel_w = rel_cd.reshape(C, S, S_E).sum(2)
    for c in range(C):
        m = is_train & (course_row == c)
        if m.sum() == 0:
            m = course_row == c
        cf[c, :, 0] = act_w[m].mean(0)
        cf[c, :, 1] = cnt_w[m].mean(0)
    cf[:, :, 2] = np.log1p(rel_w)
    cf[:, :, 3] = rel_w.cumsum(1) / np.maximum(rel_w.sum(1, keepdims=True), 1)
    cf[:, :, 4] = np.log1p(ctrain)[:, None]
    cf = (cf - cf.reshape(-1, 5).mean(0)) / (cf.reshape(-1, 5).std(0) + 1e-6)
    del tot, active, act_w, cnt_w

    # ---- siblings (same user, other courses) ----
    sib = -np.ones((N, K), np.int64)
    rng = np.random.RandomState(0)
    if not args.no_siblings:
        for _, idx in meta_df.groupby("user").indices.items():
            if len(idx) < 2:
                continue
            for i in idx:
                o = idx[idx != i]
                if len(o) > K:
                    o = rng.choice(o, K, replace=False)
                sib[i, :len(o)] = o
    # ---- v5: calendar alignment of sibling enrollments ----
    # Target snapshot s ends on calendar day cstart[c_i] + d_s - 1.  A sibling j may only
    # contribute days whose calendar date is <= that day, i.e. sibling course-day index
    # t_j <= d_s - 1 - (cstart[c_j] - cstart[c_i]).  Siblings whose course starts later
    # are masked until they have visible days; this removes calendar look-ahead.
    snap_arr = np.array(snap_days, np.int64)
    sib_ok = sib >= 0
    off = np.zeros((N, K), np.int64)
    ii = np.nonzero(sib_ok)
    off[ii] = cstart[course_row[sib[ii]]] - cstart[course_row[ii[0]]]
    n_vis = snap_arr[None, None, :] - off[..., None]                       # (N,K,S) visible sibling days
    if getattr(args, "sib_align", "calendar") == "course":                # v4 behaviour (for comparison)
        n_vis = np.broadcast_to(snap_arr[None, None, :], (N, K, S)).copy()
    sib_didx = (np.clip(n_vis, 1, NDAYS) - 1).astype(np.int16)
    sib_vis = (n_vis >= 1) & sib_ok[..., None]
    print(f"[siblings] align={getattr(args, 'sib_align', 'calendar')} | pairs {int(sib_ok.sum()):,} | "
          f"later-starting {float((off[sib_ok] > 0).mean()):.3f} | visible share by snapshot "
          f"{np.round(sib_vis.sum((0, 1)) / max(sib_ok.sum(), 1), 3).tolist()}")
    n_enr_user = meta_df.groupby("user")["user"].transform("size").values
    userf = np.stack([np.log1p(n_enr_user), (sib >= 0).sum(1) / K], 1).astype(np.float32)

    # ---- static tabular features (full period, optional) ----
    drop = {"enrollment_id", "user", "course", "_split", "target"}
    scols = [c for c in meta_df.columns if c not in drop]
    static = np.nan_to_num(meta_df[scols].values.astype(np.float32))

    T = dict(day=day, evw=evw, obj_tok=obj_tok, obj_cnt=obj_cnt, course=course_row, sib=sib,
             sib_didx=sib_didx, sib_vis=sib_vis,
             userf=userf, static=static, y=meta_df["target"].values.astype(np.float32),
             cf=cf, pop=pop, vocab=vocab, obj_type=obj_type, obj_rel=obj_rel.astype(np.float32),
             split=np.array([{"train": 0, "val": 1, "test": 2}[s] for s in meta_df["_split"].values], np.int8),
             enrollment_id=meta_df["enrollment_id"].values)
    info = dict(S=S, snap_days=snap_days, n_course=C, n_obj=O, n_vocab=int(good.sum()) + 1,
                n_day_feat=day.shape[-1], n_static=static.shape[1], M=M, K=K, snap_every=S_E)
    return T, info



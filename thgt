def main():
    args = get_args()
    kaggle = os.path.exists("/kaggle/working")
    global FIG_FORMATS
    FIG_FORMATS = tuple(f.strip() for f in args.fig_formats.split(",") if f.strip()) or ("pdf",)
    # separate output folder per sibling alignment, so cached v4 runs are never reused by v5
    out = args.out or (f"/kaggle/working/thgt_v5_{args.sib_align}_outputs" if kaggle
                       else f"./thgt_v5_{args.sib_align}_outputs")
    run_dir = os.path.join(out, "runs"); fig_dir = os.path.join(out, "figures"); tab_dir = os.path.join(out, "tables")
    for dd in (out, run_dir, fig_dir, tab_dir):
        os.makedirs(dd, exist_ok=True)
    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    seeds = [int(s) for s in args.seeds.split(",") if s != ""]
    exps = [e for e in args.exps.split(",") if e in EXPERIMENTS]
    if args.debug:
        seeds = seeds[:2]
    print(f"[device] {device} | out {out} | exps {exps} | seeds {seeds}")
    T0 = time.time()
    try:
        draw_architecture(os.path.join(fig_dir, "architecture"))
    except Exception as ex:
        print("[architecture] skipped:", ex)

    # ---------------- data / graph ----------------
    merged_path = find_file(args.merged, ["/kaggle/input/**/merged_AB_processed*", "./merged_AB_processed*",
                                          "/mnt/user-data/uploads/merged_AB_processed*"])
    log_path = find_file(args.log, ["/kaggle/input/**/log_train.csv", "/kaggle/input/**/log_train.zip",
                                    "/kaggle/input/**/log_train*", "./log_train*", "/mnt/user-data/uploads/log_train*"])
    tag = f"se{args.snap_every}_m{args.max_obj}_k{args.max_sib}_n{args.max_enroll}_{args.sib_align}"
    cache = os.path.join(out, f"graph_cache_{tag}.npz")
    if os.path.exists(cache):
        z = np.load(cache, allow_pickle=True)
        T = {k: z[k] for k in z.files if k != "info"}; info = z["info"].item()
    else:
        meta = pd.read_csv(merged_path, low_memory=False)
        fc = meta.select_dtypes(include=[np.floating]).columns
        meta[fc] = meta[fc].astype(np.float32)
        if args.max_enroll and args.max_enroll < len(meta):
            users = meta["user"].unique(); rng = np.random.RandomState(0); rng.shuffle(users)
            cs = meta.groupby("user").size().loc[users].cumsum()
            meta = meta[meta["user"].isin(set(cs[cs <= args.max_enroll].index))]
        meta = meta.reset_index(drop=True)
        logs = read_logs(log_path, set(meta["enrollment_id"]) if args.max_enroll else None)
        T, info = build_graph(logs, meta, args)
        del logs, meta; gc.collect()
        np.savez(cache, info=np.array(info, dtype=object), **T)
    print(f"[graph] {info} ({time.time()-T0:.0f}s)")

    sp, y = T["split"], T["y"]
    yv, yt = y[sp == 1], y[sp == 2]
    te_rows = np.where(sp == 2)[0]
    idx = {s: torch.tensor(np.where(sp == i)[0], device=device) for i, s in enumerate(["train", "val", "test"])}
    print({k: len(v) for k, v in idx.items()}, "| dropout rate:", round(float(y.mean()), 4))
    data = GPUData(T, info, device)

    # dataset statistics (for the paper)
    ds_stats = dict(n_enrollments=int(len(y)), n_users=None, n_courses=int(info["n_course"]),
                    n_objects=int(info["n_obj"]), n_object_vocab=int(info["n_vocab"]),
                    dropout_rate=float(y.mean()), multi_course_share=float((T["sib"][:, 0] >= 0).mean()),
                    split_sizes={k: int(len(v)) for k, v in idx.items()})

    # ---------------- THGT experiments ----------------
    R = {e: [] for e in exps}
    for e in exps:
        for s in seeds:
            R[e].append(train_run(e, s, info, data, idx, yv, args, run_dir, keep_attn=(e in ("full", "causal"))))
            print(f"  elapsed {(time.time()-T0)/60:.1f} min")

    # ---------------- occlusion (needs GPU data) ----------------
    OCC = {}
    if not args.skip_occlusion:
        for e in [x for x in ("causal", "full") if x in exps]:
            print(f"\n=== Occlusion analysis: {EXPERIMENTS[e]['name']} ===")
            OCC[e] = occlusion_analysis(e, seeds, info, data, idx, yt, args, run_dir)
    del data; gc.collect()
    if device.type == "cuda":
        torch.cuda.empty_cache()

    # ---------------- baselines ----------------
    LG, LC = [], None
    if not args.skip_lgb:
        print("\n=== LightGBM (full-period tabular features) ===")
        LG = [run_lgb_full(T, sp, s, args, run_dir) for s in seeds]
    if not args.skip_causal_lgb:
        print("\n=== Causal LightGBM (logs up to day d) ===")
        LC = run_causal_lgb(T, info, sp, args, run_dir)

    # ---------------- model registry ----------------
    LGB_NAME = "LightGBM (439 engineered feats)"
    runs = {EXPERIMENTS[e]["name"]: R[e] for e in exps}
    if LG:
        runs[LGB_NAME] = LG
    ENS_NAME = None
    if LG and "full" in exps:
        vT = np.mean([r["val_p"] for r in R["full"]], 0); vL = np.mean([r["val_p"] for r in LG], 0)
        w = tune_blend(yv, vT, vL)
        ENS_NAME = f"Ensemble THGT-Full + LightGBM (w={w:.2f})"
        runs[ENS_NAME] = [dict(val_p=blend(a["val_p"], b["val_p"], w), test_p=blend(a["test_p"], b["test_p"], w))
                          for a, b in zip(R["full"], LG)]

    # temperature scaling per run (fit on validation only)
    for name, rr in runs.items():
        for r in rr:
            t = fit_temperature(yv, r["val_p"])
            r["T"] = t
            r["val_p_ts"] = apply_temperature(r["val_p"], t)
            r["test_p_ts"] = apply_temperature(r["test_p"], t)
    avg = {n: (np.mean([r["val_p"] for r in rr], 0), np.mean([r["test_p"] for r in rr], 0)) for n, rr in runs.items()}
    avg_ts = {n: (np.mean([r["val_p_ts"] for r in rr], 0), np.mean([r["test_p_ts"] for r in rr], 0)) for n, rr in runs.items()}

    # ---------------- Table 1: main results ----------------
    rows = {}
    for name, rr in runs.items():
        per = [metrics(yt, r["test_p_ts"], best_threshold(yv, r["val_p_ts"])) for r in rr]
        va_, ta_ = avg_ts[name]
        lo, hi = bootstrap_ci(yt, ta_, args.n_boot)
        row = {}
        for k in ["auc", "pr_auc", "macro_f1", "f1", "logloss", "brier", "ece"]:
            v = [m[k] for m in per]
            row[k.upper()] = fmt(np.mean(v), np.std(v) if len(v) > 1 else None)
        row["AUC seed-avg [95% CI]"] = f"{roc_auc_score(yt, ta_):.4f} [{lo:.4f}, {hi:.4f}]"
        rows[name] = row
    main_df = pd.DataFrame(rows).T; main_df.index.name = "Model"
    main_df.to_csv(os.path.join(tab_dir, "table1_main.csv"))
    to_latex(main_df, os.path.join(tab_dir, "table1_main.tex"),
             "Test performance (temperature-scaled; mean $\\pm$ std over seeds).", "tab:main")

    # ---------------- Table 2: calibration before/after TS ----------------
    cal = []
    for name, rr in runs.items():
        for tag_, key in [("raw", "test_p"), ("TS", "test_p_ts")]:
            e_ = [ece_score(yt, r[key]) for r in rr]; b_ = [brier_score_loss(yt, r[key]) for r in rr]
            l_ = [log_loss(yt, np.clip(r[key], 1e-7, 1 - 1e-7)) for r in rr]
            cal.append(dict(model=name, calibration=tag_, T=fmt(np.mean([r["T"] for r in rr]), None, 3) if tag_ == "TS" else "1",
                            ECE=fmt(np.mean(e_), np.std(e_)), Brier=fmt(np.mean(b_), np.std(b_)),
                            LogLoss=fmt(np.mean(l_), np.std(l_))))
    cal_df = pd.DataFrame(cal)
    cal_df.to_csv(os.path.join(tab_dir, "table2_calibration.csv"), index=False)
    to_latex(cal_df.set_index("model"), os.path.join(tab_dir, "table2_calibration.tex"),
             "Calibration before and after temperature scaling.", "tab:calib")

    # ---------------- Table 3: ablation ----------------
    abl = []
    if "causal" in exps:
        ref_runs = R["causal"]; ref_avg = avg["THGT-Causal"][1]
        ref = [roc_auc_score(yt, r["test_p"]) for r in ref_runs]
        for e in ["causal", "no_graph", "no_hetero", "no_objects", "no_siblings"]:
            if e not in exps:
                continue
            a = [roc_auc_score(yt, r["test_p"]) for r in R[e]]
            row = dict(variant=EXPERIMENTS[e]["name"], AUC=fmt(np.mean(a), np.std(a)),
                       PR_AUC=fmt(np.mean([average_precision_score(yt, r["test_p"]) for r in R[e]]),
                                  np.std([average_precision_score(yt, r["test_p"]) for r in R[e]])),
                       delta=np.mean(a) - np.mean(ref))
            if e != "causal":
                pa = avg[EXPERIMENTS[e]["name"]][1]
                lo, hi = paired_boot_delta(yt, pa, ref_avg, args.n_boot)
                _, _, zz, pv = delong_test(yt, pa, ref_avg)   # sign: variant − reference
                row.update(delta_CI=f"[{lo:+.4f}, {hi:+.4f}]", z=zz, p=pv)
            abl.append(row)
    abl_df = pd.DataFrame(abl)
    if len(abl_df) and "p" in abl_df:
        m_ = abl_df["p"].notna()
        abl_df.loc[m_, "p_holm"] = holm(abl_df.loc[m_, "p"].values)
    abl_df.to_csv(os.path.join(tab_dir, "table3_ablation.csv"), index=False)
    to_latex(abl_df.set_index("variant").round(5), os.path.join(tab_dir, "table3_ablation.tex"),
             "Ablation study relative to THGT-Causal (DeLong test, Holm-adjusted).", "tab:ablation")

    # ---------------- Table 4: significance (main family, Holm) ----------------
    sig = []

    def cmp(a, b):
        if a in avg and b in avg:
            a1, a2, zz, pv = delong_test(yt, avg[a][1], avg[b][1])
            lo, hi = paired_boot_delta(yt, avg[a][1], avg[b][1], args.n_boot)
            sig.append(dict(model_A=a, model_B=b, auc_A=a1, auc_B=a2, delta=a1 - a2,
                            delta_CI=f"[{lo:+.4f}, {hi:+.4f}]", z=zz, p=pv))
    cmp("THGT-Full", LGB_NAME); cmp("THGT-Causal", LGB_NAME)
    if ENS_NAME:
        cmp(ENS_NAME, LGB_NAME); cmp(ENS_NAME, "THGT-Full")
    cmp("THGT-Full", "THGT-Causal")
    sig_df = pd.DataFrame(sig)
    if len(sig_df):
        sig_df["p_holm"] = holm(sig_df["p"].values)
        sig_df["significant (Holm, 0.05)"] = sig_df["p_holm"] < 0.05
    sig_df.to_csv(os.path.join(tab_dir, "table4_significance.csv"), index=False)

    # ---------------- Table 5: early warning (Holm) ----------------
    days = info["snap_days"]
    ew_rows, ew_curves = [], {}
    ew_src = "causal" if "causal" in exps else ("full" if "full" in exps else None)
    for s, dd in enumerate(days):
        row = {"day": dd}
        for e in [x for x in ["causal", "full", "no_graph"] if x in exps]:
            a = [roc_auc_score(yt, r["test_early"][:, s]) for r in R[e]]
            row[EXPERIMENTS[e]["name"]] = fmt(np.mean(a), np.std(a) if len(a) > 1 else None)
            ew_curves.setdefault(EXPERIMENTS[e]["name"], []).append((np.mean(a), np.std(a)))
        if LC is not None:
            a = roc_auc_score(yt, LC["test_early"][:, s])
            row["Causal-LightGBM"] = fmt(a)
            ew_curves.setdefault("Causal-LightGBM", []).append((a, 0.0))
            if ew_src:
                vT = np.mean([r["val_early"][:, s] for r in R[ew_src]], 0)
                tT = np.mean([r["test_early"][:, s] for r in R[ew_src]], 0)
                w = tune_blend(yv, vT, LC["val_early"][:, s])
                eb = blend(tT, LC["test_early"][:, s], w)
                row["Causal ensemble"] = fmt(roc_auc_score(yt, eb))
                ew_curves.setdefault("Causal ensemble", []).append((roc_auc_score(yt, eb), 0.0))
                _, _, zz, pv = delong_test(yt, tT, LC["test_early"][:, s])
                lo, hi = paired_boot_delta(yt, tT, LC["test_early"][:, s], args.n_boot)
                row["Δ THGT−LGB [95% CI]"] = f"{roc_auc_score(yt, tT) - a:+.4f} [{lo:+.4f}, {hi:+.4f}]"
                row["p"] = pv
        ew_rows.append(row)
    ew_df = pd.DataFrame(ew_rows).set_index("day")
    if "p" in ew_df:
        ew_df["p_holm"] = holm(ew_df["p"].values)
    ew_df.to_csv(os.path.join(tab_dir, "table5_early_warning.csv"))
    to_latex(ew_df, os.path.join(tab_dir, "table5_early_warning.tex"),
             "Early-warning AUC using only data up to day $d$.", "tab:early")

    # ---------------- Table 6: subgroup analysis ----------------
    sub_rows = []
    multi = T["sib"][te_rows, 0] >= 0
    act = np.expm1(T["evw"][te_rows, :, :, 0]).sum((1, 2))
    q1, q2 = np.quantile(act, [1 / 3, 2 / 3])
    groups = {"all": np.ones(len(yt), bool), "multi-course learners": multi, "single-course learners": ~multi,
              "activity: low tertile": act <= q1, "activity: mid tertile": (act > q1) & (act <= q2),
              "activity: high tertile": act > q2}
    sub_models = [n for n in ["THGT-Full", "THGT-Causal", "w/o Sibling enrollments", "w/o Graph (Temporal only)",
                              LGB_NAME, ENS_NAME] if n in avg]
    for g, m_ in groups.items():
        if m_.sum() < 50 or yt[m_].min() == yt[m_].max():
            continue
        row = dict(subgroup=g, n=int(m_.sum()), dropout_rate=round(float(yt[m_].mean()), 3))
        for n in sub_models:
            row[n] = round(float(roc_auc_score(yt[m_], avg[n][1][m_])), 4)
        if "THGT-Causal" in avg and "w/o Sibling enrollments" in avg:
            _, _, _, pv = delong_test(yt[m_], avg["THGT-Causal"][1][m_], avg["w/o Sibling enrollments"][1][m_])
            row["p (Causal vs w/o Sib)"] = pv
        if "THGT-Causal" in avg and LGB_NAME in avg:
            _, _, _, pv = delong_test(yt[m_], avg["THGT-Causal"][1][m_], avg[LGB_NAME][1][m_])
            row["p (Causal vs LGB)"] = pv
        sub_rows.append(row)
    sub_df = pd.DataFrame(sub_rows)
    sub_df.to_csv(os.path.join(tab_dir, "table6_subgroups.csv"), index=False)
    to_latex(sub_df.set_index("subgroup"), os.path.join(tab_dir, "table6_subgroups.tex"),
             "Subgroup AUC (seed-averaged predictions).", "tab:subgroups")

    # per-course robustness
    course_rows = []
    crs_te = T["course"][te_rows]
    if "THGT-Full" in avg and LGB_NAME in avg:
        for c in np.unique(crs_te):
            m_ = crs_te == c
            if m_.sum() < 50 or yt[m_].min() == yt[m_].max():
                continue
            course_rows.append(dict(course=int(c), n=int(m_.sum()), dropout=float(yt[m_].mean()),
                                    thgt_full=roc_auc_score(yt[m_], avg["THGT-Full"][1][m_]),
                                    thgt_causal=roc_auc_score(yt[m_], avg["THGT-Causal"][1][m_]) if "THGT-Causal" in avg else np.nan,
                                    lightgbm=roc_auc_score(yt[m_], avg[LGB_NAME][1][m_])))
    course_df = pd.DataFrame(course_rows)
    course_summary = {}
    if len(course_df) >= 5:
        from scipy.stats import wilcoxon
        d_ = course_df.thgt_full - course_df.lightgbm
        course_summary = dict(n_courses=len(course_df), thgt_full_wins=int((d_ > 0).sum()),
                              mean_delta=float(d_.mean()), wilcoxon_p=float(wilcoxon(d_).pvalue),
                              thgt_full_auc_mean=float(course_df.thgt_full.mean()),
                              thgt_full_auc_std=float(course_df.thgt_full.std()),
                              lgb_auc_mean=float(course_df.lightgbm.mean()), lgb_auc_std=float(course_df.lightgbm.std()))
    course_df.to_csv(os.path.join(tab_dir, "table7_per_course.csv"), index=False)

    # ---------------- Table 8: occlusion ----------------
    occ_tables = {}
    for e, df_ in OCC.items():
        if len(df_) == 0:
            continue
        g_ = df_.groupby("occluded")["delta_auc"].agg(["mean", "std"]).sort_values("mean")
        g_.columns = ["ΔAUC mean", "ΔAUC std"]
        occ_tables[e] = g_
        g_.to_csv(os.path.join(tab_dir, f"table8_occlusion_{e}.csv"))

    # ---------------- attention (seed-averaged) ----------------
    att_tables = {}
    for e in [x for x in ("full", "causal") if x in exps]:
        ta = [r["type_att"] for r in R[e] if "type_att" in r]
        ea = [r["evt_att"] for r in R[e] if "evt_att" in r]
        if ta:
            att_tables[e] = (np.mean(ta, 0), np.std(ta, 0), np.mean(ea, 0), np.std(ea, 0))
            pd.DataFrame(np.mean(ta, 0), columns=TYPE_NAMES, index=days).to_csv(os.path.join(tab_dir, f"attention_types_{e}.csv"))
            pd.DataFrame(np.mean(ea, 0), columns=ACTS, index=days).to_csv(os.path.join(tab_dir, f"attention_events_{e}.csv"))

    # ---------------- efficiency ----------------
    eff = []
    for e in exps:
        eff.append(dict(model=EXPERIMENTS[e]["name"], params_M=float(R[e][0]["n_params"]) / 1e6,
                        sec_per_epoch=float(np.mean([r.get("epoch_sec", np.nan) for r in R[e]])),
                        infer_ms_per_1k=float(np.mean([r.get("infer_ms_per_1k", np.nan) for r in R[e]])),
                        best_epoch=fmt(np.mean([float(r.get("best_epoch", np.nan)) for r in R[e]]), None, 1)))
    eff_df = pd.DataFrame(eff)
    eff_df.to_csv(os.path.join(tab_dir, "table9_efficiency.csv"), index=False)

    # ---------------- report ----------------
    def md(df, index=True):
        d = df if index else df.set_index(df.columns[0])
        return df_to_md(d.round(5) if hasattr(d, "round") else d)
    with open(os.path.join(out, "results.md"), "w", encoding="utf-8") as f:
        f.write("# THGT v4 — Results (KDD Cup 2015, test split)\n\n")
        f.write(f"Seeds {seeds}; epochs {args.epochs}; EMA {args.ema}. Probabilities temperature-scaled on validation.\n\n")
        f.write("## Dataset\n\n```\n" + json.dumps(ds_stats, indent=2) + "\n```\n\n")
        f.write("## Table 1 — Main results\n\n" + df_to_md(main_df) + "\n\n")
        f.write("## Table 2 — Calibration\n\n" + md(cal_df, False) + "\n\n")
        if len(abl_df):
            f.write("## Table 3 — Ablation\n\n" + md(abl_df, False) + "\n\n")
        if len(sig_df):
            f.write("## Table 4 — DeLong (Holm)\n\n" + md(sig_df, False) + "\n\n")
        f.write("## Table 5 — Early warning\n\n" + md(ew_df) + "\n\n")
        if len(sub_df):
            f.write("## Table 6 — Subgroups\n\n" + md(sub_df, False) + "\n\n")
        if course_summary:
            f.write("## Table 7 — Per-course robustness (THGT-Full vs LightGBM)\n\n```\n" +
                    json.dumps(course_summary, indent=2) + "\n```\n\n")
        for e, g_ in occ_tables.items():
            f.write(f"## Table 8 — Occlusion ({EXPERIMENTS[e]['name']})\n\n" + df_to_md(g_.round(5)) + "\n\n")
        for e, (tm, tsd, em, esd) in att_tables.items():
            f.write(f"## Attention ({EXPERIMENTS[e]['name']}, mean over seeds)\n\n" +
                    df_to_md(pd.DataFrame(tm, columns=TYPE_NAMES, index=days).round(3)) + "\n\n" +
                    df_to_md(pd.DataFrame(em, columns=ACTS, index=days).round(3)) + "\n\n")
        f.write("## Table 9 — Efficiency\n\n" + md(eff_df, False) + "\n")
    json.dump(dict(dataset=ds_stats, course_summary=course_summary, config=vars(args)),
              open(os.path.join(out, "summary.json"), "w"), indent=2, default=str)

    # ---------------- figures ----------------
    try:
        plt = set_pub_style()
        from sklearn.decomposition import PCA
        from sklearn.calibration import calibration_curve

        fig, ax = plt.subplots(1, 2, figsize=(12, 4))
        for e in exps:
            for r, s in zip(R[e], seeds):
                h = pd.DataFrame(json.loads(str(r["history"])))
                ax[0].plot(h.epoch, h.val_loss, alpha=.7, label=f"{e}-s{s}")
                ax[1].plot(h.epoch, h.val_auc, alpha=.7)
        ax[0].set_title("Validation loss (EMA weights)"); ax[1].set_title("Validation AUC")
        ax[0].legend(fontsize=6, ncol=3)
        fig.tight_layout(); save_figure(fig, os.path.join(fig_dir, "training_curves"))

        if len(abl_df):
            a_ = [np.mean([roc_auc_score(yt, r["test_p"]) for r in R[e]]) for e in ["causal", "no_graph", "no_hetero", "no_objects", "no_siblings"] if e in exps]
            s_ = [np.std([roc_auc_score(yt, r["test_p"]) for r in R[e]]) for e in ["causal", "no_graph", "no_hetero", "no_objects", "no_siblings"] if e in exps]
            fig = plt.figure(figsize=(7, 3.8))
            plt.barh(abl_df.variant, a_, xerr=s_, color=["#C0392B"] + ["#5D6D7E"] * (len(a_) - 1), capsize=4)
            plt.xlim(min(a_) - 0.01, max(a_) + 0.005); plt.gca().invert_yaxis()
            plt.xlabel("Test AUC (mean ± std over seeds)"); plt.title("Ablation study")
            fig.tight_layout(); save_figure(fig, os.path.join(fig_dir, "ablation"))

        fig = plt.figure(figsize=(7, 4.5))
        for name, v in ew_curves.items():
            mu = np.array([a for a, _ in v]); sd = np.array([b for _, b in v])
            plt.plot(days, mu, marker="o", label=name)
            plt.fill_between(days, mu - sd, mu + sd, alpha=.15)
        plt.xlabel("Course day d (only data ≤ d used)"); plt.ylabel("Test AUC")
        plt.title("Early dropout warning"); plt.grid(alpha=.3); plt.legend(fontsize=8)
        fig.tight_layout(); save_figure(fig, os.path.join(fig_dir, "early_warning"))

        fig, ax = plt.subplots(1, 2, figsize=(11, 4.8))
        for k, (store, ttl) in enumerate([(avg, "Before temperature scaling"), (avg_ts, "After temperature scaling")]):
            ax[k].plot([0, 1], [0, 1], "k--", lw=1)
            for name in [n for n in ["THGT-Full", "THGT-Causal", LGB_NAME, ENS_NAME] if n in store]:
                tp = store[name][1]
                fy, fx = calibration_curve(yt, tp, n_bins=12, strategy="quantile")
                ax[k].plot(fx, fy, marker=".", label=f"{name[:28]} (ECE {ece_score(yt, tp):.3f})")
            ax[k].set_title(ttl); ax[k].set_xlabel("Predicted probability"); ax[k].legend(fontsize=7)
        ax[0].set_ylabel("Observed dropout rate")
        fig.tight_layout(); save_figure(fig, os.path.join(fig_dir, "calibration"))

        for e, g_ in occ_tables.items():
            fig = plt.figure(figsize=(6.5, 4.2))
            plt.barh(g_.index, g_["ΔAUC mean"], xerr=g_["ΔAUC std"].fillna(0), color="#2471A3", capsize=3)
            plt.axvline(0, color="k", lw=.8); plt.xlabel("Δ test AUC when node type is masked")
            plt.title(f"Occlusion importance — {EXPERIMENTS[e]['name']}")
            fig.tight_layout(); save_figure(fig, os.path.join(fig_dir, f"occlusion_{e}"))

        if "full" in att_tables or "causal" in att_tables:
            e = "full" if "full" in att_tables else "causal"
            tm, tsd, em, esd = att_tables[e]
            fig, ax = plt.subplots(1, 2, figsize=(12, 4))
            for arr, sd_, nm, a, ttl in [(tm, tsd, TYPE_NAMES, ax[0], "Attention share by node type"),
                                         (em, esd, ACTS, ax[1], "Attention share across event-type nodes")]:
                im = a.imshow(arr.T, aspect="auto", cmap="viridis")
                a.set_yticks(range(len(nm))); a.set_yticklabels(nm)
                a.set_xticks(range(len(days))); a.set_xticklabels([f"d{x}" for x in days])
                for i in range(arr.shape[0]):
                    for j in range(arr.shape[1]):
                        a.text(i, j, f"{arr[i, j]:.2f}\n±{sd_[i, j]:.2f}", ha="center", va="center", fontsize=5.5, color="w")
                a.set_title(ttl + " (mean ± std, seeds)"); plt.colorbar(im, ax=a)
            fig.tight_layout(); save_figure(fig, os.path.join(fig_dir, "attention_heatmaps"))

        rz = [r for r in R.get("full", []) + R.get("causal", []) if "z" in r]
        if rz:
            Zt = rz[0]["z"].astype(np.float32); Zc = Zt - Zt.mean(0, keepdims=True)
            n, S, d = Zc.shape
            P = PCA(2, random_state=0).fit_transform(Zc.reshape(-1, d)).reshape(n, S, 2)
            fig, ax = plt.subplots(1, 2, figsize=(12, 4.8))
            for lab, c_, nm in [(0, "C0", "completed"), (1, "C3", "dropout")]:
                m = P[yt == lab].mean(0)
                ax[0].plot(m[:, 0], m[:, 1], "-o", color=c_, lw=2.5, label=nm)
                for s_, dd in enumerate(days):
                    ax[0].annotate(f"d{dd}", m[s_], fontsize=8, color=c_)
            ax[0].set_title("Mean trajectory of learner position (PCA)"); ax[0].legend(); ax[0].grid(alpha=.3)
            for rr_ in rz:
                Z_ = rr_["z"].astype(np.float32); Z_ = Z_ - Z_.mean(0, keepdims=True)
                sep = [np.linalg.norm(Z_[yt == 1, s_].mean(0) - Z_[yt == 0, s_].mean(0)) /
                       (Z_[:, s_].std(0).mean() + 1e-6) for s_ in range(S)]
                ax[1].plot(days, sep, marker="o", alpha=.6)
            ax[1].set_xlabel("course day"); ax[1].set_ylabel("centroid distance / mean std")
            ax[1].set_title("Class separation over time (all seeds)"); ax[1].grid(alpha=.3)
            fig.tight_layout(); save_figure(fig, os.path.join(fig_dir, "position_trajectories"))

        if len(course_df):
            fig = plt.figure(figsize=(5, 5))
            plt.scatter(course_df.lightgbm, course_df.thgt_full, s=course_df.n / 10, alpha=.7)
            lo_ = min(course_df.lightgbm.min(), course_df.thgt_full.min()) - .01
            plt.plot([lo_, 1], [lo_, 1], "k--", lw=1)
            plt.xlabel("LightGBM AUC"); plt.ylabel("THGT-Full AUC"); plt.title("Per-course AUC (size ∝ n)")
            fig.tight_layout(); save_figure(fig, os.path.join(fig_dir, "per_course"))
    except Exception as ex:
        import traceback; traceback.print_exc()
        print("[figures] partially skipped:", ex)

    pd.set_option("display.width", 250); pd.set_option("display.max_columns", 30)
    print("\n" + "=" * 110 + "\nTABLE 1 — MAIN RESULTS (test, temperature-scaled)\n" + "=" * 110)
    print(main_df.to_string())
    print("\nTABLE 2 — CALIBRATION\n", cal_df.to_string(index=False))
    if len(abl_df):
        print("\nTABLE 3 — ABLATION\n", abl_df.round(5).to_string(index=False))
    if len(sig_df):
        print("\nTABLE 4 — DELONG (Holm)\n", sig_df.round(5).to_string(index=False))
    print("\nTABLE 5 — EARLY WARNING\n", ew_df.to_string())
    if len(sub_df):
        print("\nTABLE 6 — SUBGROUPS\n", sub_df.round(5).to_string(index=False))
    if course_summary:
        print("\nTABLE 7 — PER-COURSE\n", course_summary)
    for e, g_ in occ_tables.items():
        print(f"\nTABLE 8 — OCCLUSION ({e})\n", g_.round(5).to_string())
    print("\nTABLE 9 — EFFICIENCY\n", eff_df.to_string(index=False))
    print(f"\n[done] outputs → {out}   (results.md, tables/, figures/)   total {(time.time()-T0)/60:.1f} min")


if __name__ == "__main__":
    main()

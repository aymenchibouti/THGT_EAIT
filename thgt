    return plt


def save_figure(fig, path_noext, formats=None):
    """Save a matplotlib figure in every requested format; PDF is vector with embedded fonts."""
    import matplotlib.pyplot as plt
    formats = formats or FIG_FORMATS
    written = []
    for fmt in formats:
        fmt = fmt.strip().lower().lstrip(".")
        if not fmt:
            continue
        path = f"{path_noext}.{fmt}"
        kw = dict(bbox_inches="tight")
        if fmt == "pdf":
            kw["metadata"] = {"Creator": "THGT v5", "Title": os.path.basename(path_noext)}
        else:
            kw["dpi"] = 300
        fig.savefig(path, format=fmt, **kw)
        written.append(path)
    plt.close(fig)
    print("   [figure] " + ", ".join(os.path.basename(w) for w in written))
    return written



def fit_temperature(yv, pv):
    from scipy.optimize import minimize_scalar
    z = logit(pv)
    f = lambda t: log_loss(yv, 1 / (1 + np.exp(-z / t)), labels=[0, 1])
    return float(minimize_scalar(f, bounds=(0.05, 10.0), method="bounded").x)


def apply_temperature(p, t):
    return 1 / (1 + np.exp(-logit(p) / t))


def holm(pvals):
    p = np.asarray(pvals, float); m = len(p)
    order = np.argsort(p); adj = np.empty(m); run = 0.0
    for r, i in enumerate(order):
        run = max(run, (m - r) * p[i]); adj[i] = min(1.0, run)
    return adj


def paired_boot_delta(y, pa, pb, n=1000, seed=0):
    rng = np.random.RandomState(seed); N = len(y); d = []
    for _ in range(n):
        i = rng.randint(0, N, N)
        if y[i].min() != y[i].max():
            d.append(roc_auc_score(y[i], pa[i]) - roc_auc_score(y[i], pb[i]))
    return float(np.percentile(d, 2.5)), float(np.percentile(d, 97.5))


def occlusion_analysis(exp_key, seeds, info, data, idx, yt, base_args, run_dir):
    path = os.path.join(run_dir, f"occlusion_{exp_key}.csv")
    if os.path.exists(path):
        return pd.read_csv(path)
    targets = ["user", "course", "event_type", "object", "sibling"] + [f"evt:{k}" for k in range(7)]
    rows = []
    for s in seeds:
        ck = os.path.join(run_dir, f"{exp_key}_s{s}_model.pt")
        if not os.path.exists(ck):
            continue
        a = copy.copy(base_args)
        for k, v in EXPERIMENTS[exp_key]["flags"].items():
            setattr(a, k, v)
        model = THGTv2(info, a).to(data.dev)
        model.load_state_dict(torch.load(ck, map_location=data.dev))
        base = roc_auc_score(yt, run_epoch(model, data, idx["test"], a)["p"])
        for tg in targets:
            auc = roc_auc_score(yt, run_epoch(model, data, idx["test"], a, occl=(tg,))["p"])
            name = f"event:{ACTS[int(tg[4:])]}" if tg.startswith("evt:") else tg
            rows.append(dict(seed=s, occluded=name, auc=auc, delta_auc=auc - base))
        print(f"  occlusion {exp_key} seed {s} done (base AUC {base:.4f})")
        del model
    df = pd.DataFrame(rows)
    df.to_csv(path, index=False)
    return df



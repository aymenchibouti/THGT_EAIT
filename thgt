def to_latex(df, path, caption, label):
    try:
        t = df.copy().astype(str).apply(lambda c: c.str.replace("±", r"$\pm$", regex=False))
        with open(path, "w") as f:
            f.write(t.to_latex(escape=False, caption=caption, label=label))
    except Exception as ex:
        print("[latex] skipped", path, ex)


